HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Ollama (native API — no /v1 suffix)
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=mistral-large-3:675b-cloud
MEDGEMMA_MODEL=MedAIBase/MedGemma1.5:4b

# Database (PostgreSQL) — conversation checkpoints
DATABASE_URL=postgresql://localhost:5432/health_ai

# Redis — task store (ephemeral, TTL-based)
REDIS_URL=redis://localhost:6379/0
TASK_TTL_SECONDS=3600

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
